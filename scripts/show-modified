#!/usr/bin/env bash
# List managed paths that differ between the source and home directory.
#
# Usage: ./scripts/show-modified [--diff] [--skip-templates]
#        ./scripts/show-modified --paths-only [--null] [--skip-templates]
#
# --diff             Show changes from rendered source to home (--reverse).
# --paths-only       Print bare paths (use --null when piping to xargs -0).
# --null             Separate bare paths with NUL bytes instead of newlines.
# --skip-templates   Exclude templates; merge those into the source manually.
#
set -euo pipefail

paths_only=0
skip_templates=0
show_diff=0
null_output=0
for arg in "$@"; do
  case "$arg" in
    --paths-only) paths_only=1 ;;
    --skip-templates) skip_templates=1 ;;
    --diff) show_diff=1 ;;
    --null) null_output=1; paths_only=1 ;;
    -h|--help) sed -n '2,/^set /{ /^set /d; s/^# \{0,1\}//; p; }' "$0"; exit 0 ;;
    *) printf 'Unknown flag: %s\n' "$arg" >&2; exit 2 ;;
  esac
done
if ((show_diff && paths_only)); then
  echo '--diff cannot be combined with --paths-only or --null' >&2
  exit 2
fi

source_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
status=$(chezmoi --source "$source_dir" status --path-style=absolute)
targets=()
while IFS= read -r entry; do
  [[ "${entry:1:1}" == M ]] || continue
  target=${entry:3}
  source_path=$(chezmoi --source "$source_dir" source-path -- "$target")
  is_template=0
  [[ "$source_path" == *.tmpl ]] && is_template=1
  if ((skip_templates && is_template)); then
    continue
  fi
  if ((show_diff)); then
    targets+=("$target")
  elif ((null_output)); then
    printf '%s\0' "$target"
  elif ((paths_only)); then
    printf '%s\n' "$target"
  elif ((is_template)); then
    printf '%s (template)\n' "$target"
  else
    printf '%s\n' "$target"
  fi
done <<< "$status"

if ((show_diff && ${#targets[@]})); then
  chezmoi --source "$source_dir" --no-pager diff --reverse -- "${targets[@]}"
fi
