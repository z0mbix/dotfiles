# vim: set ft=dosini commentstring=#\ %s:

theme = "Rose Pine Moon"

maximize = true

clipboard-read = allow
copy-on-select = true
cursor-style = block
focus-follows-mouse = true
{{- if eq .chezmoi.os "darwin" }}

macos-icon = retro
macos-non-native-fullscreen = true
macos-option-as-alt = right
macos-titlebar-style = tabs
{{- end }}

mouse-hide-while-typing = true
quit-after-last-window-closed = true
scrollback-limit = 10000000
shell-integration = fish
shell-integration-features = no-cursor,no-sudo,no-title
unfocused-split-opacity = 0.8
window-save-state = always
window-theme = system

working-directory = "~/Repos"

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

{{- if eq .chezmoi.os "darwin" }}
font-size = 13
{{- else }}
font-size = 10
{{- end }}
font-thicken = true

# JetBrains Mono - https://www.jetbrains.com/lp/mono/
font-family = "JetBrainsMono Nerd Font Mono"
font-feature = "calt"
font-feature = "zero"

# Alt+Left / Alt+Right: jump one word backward / forward (right Option only)
keybind = alt+left=esc:b
keybind = alt+right=esc:f

# Shift+Enter -> CSI 13;2u: the Kitty keyboard protocol encoding that TUIs
# (Crush, etc.) match on. Overriding this with text:\x1b\r hides the key from
# them and gets read as escape-then-enter instead.
# keybind = shift+enter=csi:13;2u
{{- if eq .chezmoi.os "darwin" }}

# Cmd+Shift+M: toggle mouse reporting off, so Cmd+click reaches Ghostty's URL
# handler instead of being swallowed by a TUI that has captured the mouse.
keybind = cmd+shift+m=toggle_mouse_reporting

# Cmd+Right -> Ctrl-E: jump to end of line
keybind = cmd+right=text:\x05

# Cmd+FwdDelete -> Ctrl-K: kill from cursor to end of line
keybind = cmd+delete=text:\x0b

# Cmd+Backspace -> Ctrl-U: kill from cursor to start of line
keybind = cmd+backspace=text:\x15

# Opt+FwdDelete: delete word forward (works on either Option key)
keybind = opt+delete=esc:d

# Opt+Backspace -> ESC+DEL: delete word backward, stopping at punctuation (works on either Option key)
keybind = opt+backspace=text:\x1b\x7f
{{- end }}
{{- if eq .chezmoi.os "linux" }}

keybind = cmd+right=text:\x05
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = cmd+delete=text:\x0b
keybind = cmd+backspace=text:\x15
keybind = opt+delete=esc:d
keybind = alt+backspace=text:\x1b\x7f

# Super pane/window bindings to mirror macOS behavior
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+[=goto_split:next
keybind = super+]=goto_split:previous
keybind = super+n=new_window
keybind = super+shift+enter=toggle_split_zoom

# Super tab bindings to mirror macOS Cmd behavior on Linux
keybind = super+t=new_tab
keybind = super+shift+]=next_tab
keybind = super+shift+[=previous_tab
{{- end }}
