{{- /* vim: set filetype=gotmpl: */ -}}
{{- $emailAddress := promptStringOnce . "email" "What is your email address" "zombie@zombix.org" -}}
{{- $gitSigningKey := promptStringOnce . "git.signingKey" "What's your Git signing key" -}}
{{- $workComputer := false -}}
{{- $githubUser := "z0mbix" -}}
{{- $gitName := "z0mbix" -}}
{{- if not (eq $emailAddress "zombie@zombix.org") -}}
{{- $workComputer = true -}}
{{- $githubUser = promptStringOnce . "github.user" "What is your GitHub username" -}}
{{- $gitName = "David Wooldridge" -}}
{{- end -}}
{{- $brewPath := "/opt/homebrew/bin/brew" -}}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
{{- $brewPath = "/usr/local/bin/brew" -}}
{{- end -}}

data:
  email: {{ $emailAddress }}
  workComputer: {{ $workComputer }}
  brewPath: {{ $brewPath }}
  git:
    email: {{ $emailAddress }}
    name: {{ $gitName | quote }}
    signingKey: {{ $gitSigningKey | quote }}
  github:
    user: {{ $githubUser }}

merge:
  command: nvim
  args:
    - -d
    - {{ printf "%q" "{{ .Destination }}" }}
    - {{ printf "%q" "{{ .Source }}" }}
    - {{ printf "%q" "{{ .Target }}" }}
